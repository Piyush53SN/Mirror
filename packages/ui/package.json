{
  "name": "@mirror/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Mirror design system \u2014 React Native primitives built on image-derived tokens (Frosted Horizon).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tabs": "./screens/tabs.ts",
    "./screens": "./screens/index.tsx",
    "./tokens": "./tokens/index.ts",
    "./render": "./screens/render.tsx"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mockups": "node mockups/render.mjs",
    "test": "node --test tests/ui.test.mjs tests/mockups.test.mjs tests/import.test.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.88"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.0",
    "react-test-renderer": "^19.3.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@mirror/core-analytics": "0.0.0",
    "@mirror/importers": "0.0.0"
  }
}
